{
  "name": "websiteni-starter-theme",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "description": "WebsiteNI WordPress starter theme - Tailwind CSS edition",
  "scripts": {
    "dev": "vite build --watch",
    "watch": "vite build --watch",
    "build": "vite build",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:php",
    "lint:js": "eslint assets/scripts",
    "lint:css": "stylelint \"assets/styles/**/*.css\"",
    "lint:php": "vendor/bin/phpcs"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "not IE 11"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.11.0",
    "stylelint": "^17.15.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "hamburgers": "^1.2.1"
  }
}
